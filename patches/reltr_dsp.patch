@@ -0,0 +1,147 @@
+# DSP_S P11 (require mục 9): lưu nguyên tử, chọn checkpoint hợp lệ, STATUS.json, trạng thái RNG.
+import hashlib
+import json
+import os
+import random
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+
+REQUIRED_KEYS = ("model", "optimizer", "lr_scheduler", "scaler", "epoch", "iter_in_epoch", "global_step",
+                 "epoch_complete", "sampler", "rng", "meta", "args")
+
+
+def sha256_file(path, chunk=1 << 22):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for b in iter(lambda: f.read(chunk), b""):
+            h.update(b)
+    return h.hexdigest()
+
+
+def _atomic_torch_save(obj, path):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_name(path.name + ".tmp")
+    with open(tmp, "wb") as f:
+        torch.save(obj, f)
+        f.flush()
+        os.fsync(f.fileno())
+    return tmp
+
+
+def save_last(ckpt_dir, state):
+    """require 9.3: ghi last.pth.tmp -> last.pth thành last_prev.pth -> tmp thành last.pth. Trả về sha256."""
+    ckpt_dir = Path(ckpt_dir)
+    last, prev = ckpt_dir / "last.pth", ckpt_dir / "last_prev.pth"
+    tmp = _atomic_torch_save(state, last)
+    if last.exists():
+        os.replace(last, prev)
+    os.replace(tmp, last)
+    assert last.stat().st_size > 0, "last.pth rỗng sau khi lưu"
+    return sha256_file(last)
+
+
+def save_weights(path, model_state):
+    tmp = _atomic_torch_save({"model": model_state}, path)
+    os.replace(tmp, path)
+    assert Path(path).stat().st_size > 0
+    return sha256_file(path)
+
+
+def read_status(run_dir):
+    p = Path(run_dir) / "STATUS.json"
+    if not p.exists():
+        return {}
+    try:
+        return json.loads(p.read_text(encoding="utf-8"))
+    except Exception:
+        return {}
+
+
+def update_status(run_dir, **fields):
+    run_dir = Path(run_dir)
+    st = read_status(run_dir)
+    st.update(fields)
+    st["updated"] = time.strftime("%Y-%m-%d %H:%M:%S")
+    tmp = run_dir / "STATUS.json.tmp"
+    tmp.write_text(json.dumps(st, indent=1, ensure_ascii=False), encoding="utf-8")
+    os.replace(tmp, run_dir / "STATUS.json")
+    return st
+
+
+def try_load(path):
+    """Nạp checkpoint đầy đủ; None nếu hỏng hoặc thiếu trường."""
+    try:
+        ck = torch.load(path, map_location="cpu", weights_only=False)
+    except Exception as e:  # file cắt cụt, hỏng zip, ...
+        print(f"[checkpoint] bỏ {path}: không đọc được ({type(e).__name__})")
+        return None
+    miss = [k for k in REQUIRED_KEYS if k not in ck]
+    if miss:
+        print(f"[checkpoint] bỏ {path}: thiếu trường {miss}")
+        return None
+    return ck
+
+
+def find_candidates(search_roots):
+    out = []
+    for root in search_roots:
+        root = Path(root)
+        if not root.exists():
+            continue
+        for name in ("last.pth", "last_prev.pth"):
+            out += sorted(root.rglob(name))
+    return out
+
+
+def select_checkpoint(search_roots, load=True, run_filter=None):
+    """require 9.4: bỏ file không đọc được hoặc sai sha256 (nếu STATUS.json có ghi), chọn global_step lớn nhất.
+    run_filter(run_dir) -> bool: chỉ xét checkpoint trong <run_dir>/ckpt thỏa điều kiện.
+    Trả về (path, ckpt | None, global_step) hoặc (None, None, -1)."""
+    best = (None, None, -1)
+    for p in find_candidates(search_roots):
+        if run_filter is not None and not run_filter(p.parent.parent):
+            continue
+        st = read_status(p.parent.parent)
+        known = st.get("known_ckpt_sha256", {})
+        sha = sha256_file(p)
+        if known and sha not in known:
+            # có thể là lần lưu bị ngắt trước khi kịp ghi STATUS.json: vẫn thử đọc, nhưng ghi cảnh báo
+            print(f"[checkpoint] cảnh báo: sha256 của {p} không có trong STATUS.json")
+        ck = try_load(p)
+        if ck is None:
+            continue
+        gs = int(ck["global_step"])
+        print(f"[checkpoint] hợp lệ: {p} global_step={gs} epoch={ck['epoch']} iter={ck['iter_in_epoch']} sha256={sha[:12]}")
+        if gs > best[2]:
+            best = (p, ck if load else None, gs)
+    return best
+
+
+def capture_rng():
+    st = {"python": random.getstate(), "numpy": np.random.get_state(), "torch": torch.get_rng_state()}
+    if torch.cuda.is_available():
+        st["cuda"] = torch.cuda.get_rng_state()
+    return st
+
+
+def restore_rng(st):
+    random.setstate(st["python"])
+    np.random.set_state(st["numpy"])
+    torch.set_rng_state(st["torch"])
+    if "cuda" in st and torch.cuda.is_available():
+        torch.cuda.set_rng_state(st["cuda"])
+
+
+def state_dict_sha256(sd):
+    """sha256 của trọng số (G6 b): băm từng tensor theo thứ tự tên."""
+    h = hashlib.sha256()
+    for k in sorted(sd):
+        v = sd[k]
+        if torch.is_tensor(v):
+            h.update(k.encode())
+            h.update(v.detach().cpu().contiguous().view(-1).view(torch.uint8).numpy().tobytes())
+    return h.hexdigest()

+    def _broadcast(self, flag):
+        if utils.is_dist_avail_and_initialized():
+            t = torch.tensor([flag], dtype=torch.int32, device=self.device)
+            torch.distributed.broadcast(t, src=0)
+            flag = int(t.item())
+        return flag
+
+    def decide(self, force_check=False):
+        if self.max_iters and self.global_step >= self.max_iters:
+            return self.MAX_ITERS
+        if not force_check and self.global_step % self.check_every != 0:
+            return self.CONTINUE
+        flag = self.CONTINUE
+        if utils.is_main_process():
+            if self.deadline and time.time() >= self.deadline:
+                flag = self.DEADLINE
+            elif self.ckpt_every and time.time() - self.last_ckpt >= self.ckpt_every:
+                flag = self.CKPT
+        flag = self._broadcast(flag)
+        if flag == self.CKPT:
+            self.last_ckpt = time.time()
+        return flag

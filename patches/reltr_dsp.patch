@@ -0,0 +1,49 @@
+# DSP_S P10/P11 (require 9.4): sampler chia theo rank, resume được giữa epoch.
+import math
+
+import torch
+from torch.utils.data import Sampler
+
+
+class ResumableDistributedSampler(Sampler):
+    """Giống DistributedSampler(shuffle=True, drop_last=False): mỗi epoch hoán vị bằng seed + epoch,
+    đệm cho chia hết số rank rồi lấy indices[rank::num_replicas]. Ở epoch đang dở, bỏ qua
+    start_iter * batch_size chỉ số đầu của rank này mà không nạp ảnh. Chạy được với 1 tiến trình."""
+
+    def __init__(self, dataset_len, num_replicas=1, rank=0, seed=42, batch_size=1):
+        self.dataset_len = dataset_len
+        self.num_replicas = num_replicas
+        self.rank = rank
+        self.seed = seed
+        self.batch_size = batch_size
+        self.num_samples = math.ceil(dataset_len / num_replicas)
+        self.total_size = self.num_samples * num_replicas
+        self.epoch = 0
+        self.start_iter = 0
+
+    def set_epoch(self, epoch, start_iter=0):
+        self.epoch = epoch
+        self.start_iter = start_iter
+
+    def indices_for_epoch(self, epoch):
+        g = torch.Generator()
+        g.manual_seed(self.seed + epoch)
+        idx = torch.randperm(self.dataset_len, generator=g).tolist()
+        pad = self.total_size - len(idx)
+        if pad > 0:
+            idx += (idx * math.ceil(pad / len(idx)))[:pad]
+        return idx[self.rank:self.total_size:self.num_replicas]
+
+    def __iter__(self):
+        idx = self.indices_for_epoch(self.epoch)
+        return iter(idx[self.start_iter * self.batch_size:])
+
+    def __len__(self):
+        return self.num_samples - self.start_iter * self.batch_size
+
+    def iters_per_epoch(self):
+        return self.num_samples // self.batch_size
+
+    def state(self):
+        return {"seed": self.seed, "epoch": self.epoch, "world_size": self.num_replicas,
+                "batch_size_per_gpu": self.batch_size, "num_samples": self.num_samples}

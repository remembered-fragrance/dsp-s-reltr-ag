+    def __init__(self, global_step, deadline_unix=0, ckpt_every_min=30, max_iters=0, check_every=20, device='cpu'):
+        self.global_step = global_step
+        self.deadline = deadline_unix
+        self.ckpt_every = ckpt_every_min * 60
+        self.max_iters = max_iters
+        self.check_every = check_every

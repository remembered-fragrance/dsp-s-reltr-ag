+class TrainControl:
+    """DSP_S P12 (require SR-2, 9.2): quyết định dừng/lưu.
+    --max_iters so với global_step nên mọi rank tự quyết giống nhau; hạn giờ và lưu định kỳ do rank 0
+    quyết rồi broadcast mỗi `check_every` vòng lặp, để các rank không lệch nhau một bước (DDP treo)."""
+    CONTINUE, CKPT, DEADLINE, MAX_ITERS = 0, 1, 2, 3
